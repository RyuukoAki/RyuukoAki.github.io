---
// src/pages/contact.astro
import "../styles/global.css";
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/HeroCentered.astro';
import AbstractBG from "../components/bg/AbstractBG4.astro";
import RecentProjectBento from '../components/bento/RecentProjectsBento.astro';
---
<BaseLayout title="Contact">
	<AbstractBG slot="hero">
		<Hero>
			<h1 slot="title" class="mt-2 text-4xl font-wixdisplay tracking-tight text-pretty text-pale-slate sm:text-5xl ">Contact Ava</h1>
			<h3 slot="subtitle" class="mt-6 text-2xl font-wixdisplay tracking-tight text-pretty text-pale-slate sm:text-3xl">I'd love to hear from you!</h3>
			<p slot="description" class="mt-6 text-lg text-gray-300">Whether you have a question, a project idea, or just want to connect, please feel welcome to reach out.</p>
			<div slot="actions" class="mt-10 flex flex-col items-center gap-x-4 gap-y-4 sm:flex-row lg:gap-x-6 ">
				<a href="mailto:nvrzdvj0a@mozmail.com" 
					class="rounded-3xl bg-pale-slate px-3.5 py-2.5 text-lg text-center font-semibold text-wine shadow-xs hover:bg-wine hover:text-pale-slate hover:scale-110 transition-transform duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry">
					Send an Email</a>
				<a href="https://www.linkedin.com/in/ava-daly/" 
					class="rounded-3xl bg-pale-slate/75 px-3.5 py-2.5 text-lg text-center font-semibold text-wine shadow-xs hover:bg-wine hover:text-pale-slate hover:scale-110 transition-transform duration-300  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry" target="_blank" rel="noopener noreferrer">
					Connect on LinkedIn</a>
			</div>
		</Hero>
	</AbstractBG>
  <RecentProjectBento slot="main" />
</BaseLayout>