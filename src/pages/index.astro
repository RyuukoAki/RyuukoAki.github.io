---
// src/pages/index.astro
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import AbstractBG from "../components/bg/AbstractBG.astro";
import Hero from "../components/hero/HeroCentered.astro";
import RecentProjectBento from '../components/bento/RecentProjectsBento.astro';

---

<BaseLayout title="Home">
  <AbstractBG slot="hero">
    <Hero>
      <h1
        slot="title"
        class="mt-16 font-black tracking-tight text-balance text-onyx-20 dark:text-pale-slate"
      >
        Ava Daly
      </h1>
      <h2
        slot="subtitle"
        class="font-wix font-light tracking-tight text-balance text-onyx-20 dark:text-pale-slate-90"
      >
        Creative Industry Project Manager
      </h2>
      <p
        slot="description"
        class="font-wix mt-4 text-lg font-light text-pretty text-onyx-30 dark:text-onyx-60"
      >
        Creating. Aligning. Inspiring.
      </p>
      <a
        slot="actions"
        href="/contact"
        class="rounded-3xl bg-pale-slate/90 px-3.5 py-2.5 font-bold text-wine shadow-sm hover:scale-120 transition-transform duration-300 hover:bg-cherry hover:text-pale-slate focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry"
      >
        Contact</a
      >
      <a
        slot="actions"
        href="/projects"
        class="rounded-3xl bg-onyx-10/10 px-3.5 py-2.5 font-regular text-pink-wine shadow-xs dark:text-pale-slate/80 hover:scale-110 transition-transform duration-300 hover:bg-pink-wine hover:text-pale-slate focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry"
      >
        Browse Projects<span aria-hidden="true">→</span></a
      >
    </Hero>
  </AbstractBG>
  <div
    slot="main"
    class="p-8 mt-32 rounded-2xl shadow-2xl bg-pale-slate/10 dark:bg-slate/10 lg:mx-32"
  >
    <h1 class="text-3xl font-wix text-pink-wine-50 font-bold">
      Structure Behind Craft
    </h1>
    <p
      class="font-noto mt-4 text-md text-balance text-onyx dark:text-pale-slate"
    > Hiya! I'm Ava!<br /><br />
      I'm a project manager and business analyst thriving at the intersection of 
      creativity, tehnology, and strategy. My work lies in aligning cross-functional 
      teams of designers, engineers, and stakeholders so that everyone stays focused 
      and motivated while working towards the same goal. <br /><br />
      I come with deep hands-on experience across the full project lifecycle. 
      I speak the language of both the doers and decision-makers, building stronger 
      communication by avoiding the "messenger" trap of management. 
      I don't just track tasks; I understand the requirements and work behind them,
      which lets me anticipate bottlenecks, translate needs accross departments, 
      and protect your team's most valuable resource, their time.<br /><br />
      My role is handling the operational load: sprint planning, issue prioritization,
      stakeholder updates, and the bureaucratic heavy-lifting that keeps projects
      moving smoothly. While I enjoy creative disciplines myself, my impact comes
      from organizing the work and creating the conditions for world-class specialists
      to do their best. <br /><br />
      With dual degrees in Business Administration and New Media, plus international experience 
      and a proven track record leading teams from conception to launch, I bring the 
      big-picture strategy and the ground-level discipline needed to drive success, 
      no matter the industry or scale. <br /><br />
    </p>
    <p class="pb-5">Let's talk about how I can support your next project!</p>
    <div class="flex gap-4 flex-wrap">
      <a
        href="/contact"
        class="rounded-3xl bg-pale-slate/90 px-3.5 py-2.5 font-bold text-wine shadow-sm hover:scale-110 transition-transform duration-300 hover:bg-cherry hover:text-pale-slate focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry"
      >
        Get in Touch</a
      >
      <a
        href="/projects"
        class="rounded-3xl bg-onyx-10/10 px-3.5 py-2.5 font-regular text-pink-wine shadow-xs dark:text-pale-slate/80 hover:scale-110 transition-transform duration-300 hover:bg-pink-wine hover:text-cherry-60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry"
      >
        Browse Previous Works<span aria-hidden="true">→</span></a
      >
    </div>
  </div>

  <RecentProjectBento slot="main" />
</BaseLayout>
