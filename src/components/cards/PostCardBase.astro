---
import { Image } from "astro:assets";
const { post, href } = Astro.props;
---

<a
  href={href}
  class="flex mb-4 max-w-1/1 rounded-xl shadow-xl ring-1 ring-white/10 hover:scale-103 transition-transform duration-300 hover:shadow-3xl sm:w-228 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cherry"
>
<div class="max-w-2/5 overflow-hidden rounded-xl bg-pink-wine">
    <Image
      src={post.cover}
      alt={post.coverAlt}
      class=""
    />
  </div>
    <div class="m-4">
    <h4
      class="font-wix font-semibold tracking-tight text-onyx dark:text-pale-slate"
    >
      {post.title}
    </h4>
    <p
      class="pb-1 text-sm font-noto text-onyx dark:text-pale-slate"
    >
      {post.description}
    </p>
    <h6
      class="font-wix font-semibold tracking-tight text-onyx dark:text-pale-slate"
    >
      {post.pubDate}
    </h6>
  </div>
</a>
