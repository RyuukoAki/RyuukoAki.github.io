---
// src/components/MarkdownLink.astro
const { href, children } = Astro.props;
---

<a 
  href={href} 
  class="text-blue-500 hover:text-blue-700 underline transition-colors duration-200"
  target={href?.startsWith('http') ? '_blank' : undefined}
  rel={href?.startsWith('http') ? 'noopener noreferrer' : undefined}
>
  {children}
</a>